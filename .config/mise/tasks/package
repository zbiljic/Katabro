#!/bin/bash
#MISE description="Package the universal app with its CLI"

set -euo pipefail

version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' Resources/Info.plist)
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Expected a numeric major.minor.patch version in Resources/Info.plist" >&2
    exit 1
fi

mise run app:generate
mise exec -- tuist xcodebuild build \
    -workspace Katabro.xcworkspace \
    -scheme Katabro \
    -configuration Release \
    -destination 'generic/platform=macOS' \
    -derivedDataPath DerivedData/Release \
    'ARCHS=arm64 x86_64' ONLY_ACTIVE_ARCH=NO ENABLE_CODE_COVERAGE=NO \
    CODE_SIGN_IDENTITY=- CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM= \
    CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO

app_path="$PWD/DerivedData/Release/Build/Products/Release/Katabro.app"
output_directory="$PWD/dist"
mkdir -p "$output_directory"

codesign --verify --deep --strict "$app_path"
for binary in "$app_path/Contents/MacOS/Katabro" "$app_path/Contents/Helpers/katabro"; do
    codesign --verify --strict "$binary"
    xcrun lipo "$binary" -verify_arch arm64 x86_64
    load_commands=$(xcrun otool -l "$binary")
    if [[ "$load_commands" == *'__llvm_prf_'* ]]; then
        echo "Release binary contains coverage instrumentation: $binary" >&2
        exit 1
    fi
done

codesign --display --entitlements - --xml "$app_path" > DerivedData/Release/entitlements.plist
python3 -I - "$app_path" DerivedData/Release/entitlements.plist "$version" <<'PY'
import pathlib
import plistlib
import sys

app = pathlib.Path(sys.argv[1])
with (app / "Contents/Info.plist").open("rb") as file:
    info = plistlib.load(file)
with open(sys.argv[2], "rb") as file:
    entitlements = plistlib.load(file)
assert info["CFBundleShortVersionString"] == sys.argv[3], "Release version mismatch"
assert info["LSUIElement"] is True, "Release must remain menu-bar-only"
assert entitlements.get("com.apple.security.app-sandbox") is True, "Sandbox missing"
assert not entitlements.get("com.apple.security.get-task-allow"), "Debug entitlement present"
assert not any("icloud" in key.lower() or "ubiquity" in key for key in entitlements), "iCloud entitlement present"
assert not (app / "Contents/embedded.provisionprofile").exists(), "Provisioned build selected"
PY

archive="Katabro-$version-universal.zip"
ditto -c -k --sequesterRsrc --keepParent "$app_path" "$output_directory/$archive"
cp -f DerivedData/Release/SourcePackages/checkouts/MenuBarExtraAccess/LICENSE \
    "$output_directory/MenuBarExtraAccess-LICENSE"
/usr/bin/zip -j -q "$output_directory/$archive" LICENSE "$output_directory/MenuBarExtraAccess-LICENSE"

cd "$output_directory"
shasum -a 256 "$archive" > "$archive.sha256"

echo "App and bundled CLI release: $output_directory/$archive"
