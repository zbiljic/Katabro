#!/bin/sh

set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$script_directory")
source_icon="$project_root/Resources/Branding/KatabroIcon/AppIcon.svg"
catalog_directory="$project_root/Resources/Assets.xcassets/AppIcon.appiconset"
catalog_manifest="$catalog_directory/Contents.json"

require_command() {
    command_name=$1
    installation_hint=$2

    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "Required command not found: $command_name" >&2
        echo "$installation_hint" >&2
        exit 1
    fi
}

require_command rsvg-convert "Install librsvg with: brew install librsvg"
require_command pngquant "Run this script through: mise run icon:generate"
require_command oxipng "Run this script through: mise run icon:generate"
require_command jq "Run this script through: mise run icon:generate"

if ! test -f "$source_icon"; then
    echo "Application-icon source not found: $source_icon" >&2
    exit 1
fi

if ! test -f "$catalog_manifest"; then
    echo "Application-icon catalog manifest not found: $catalog_manifest" >&2
    exit 1
fi

working_directory=$(mktemp -d "${TMPDIR:-/tmp}/katabro-app-icon.XXXXXX")
trap 'rm -R "$working_directory"' EXIT HUP INT TERM

render_representation() {
    filename=$1
    pixel_size=$2
    rendered_file="$working_directory/rendered-$filename"
    optimized_file="$working_directory/$filename"

    rsvg-convert \
        --width "$pixel_size" \
        --height "$pixel_size" \
        "$source_icon" \
        --output "$rendered_file"

    pngquant \
        --quality=90-100 \
        --speed 1 \
        --strip \
        --force \
        --output "$optimized_file" \
        "$rendered_file"

    oxipng -o 4 --strip safe --quiet "$optimized_file"

    actual_width=$(sips -g pixelWidth "$optimized_file" 2>/dev/null | awk '/pixelWidth/ { print $2 }')
    actual_height=$(sips -g pixelHeight "$optimized_file" 2>/dev/null | awk '/pixelHeight/ { print $2 }')

    if test "$actual_width" != "$pixel_size" || test "$actual_height" != "$pixel_size"; then
        echo "Unexpected dimensions for $filename: ${actual_width}x${actual_height}" >&2
        exit 1
    fi
}

render_representation AppIcon-16.png 16
render_representation AppIcon-16@2x.png 32
render_representation AppIcon-32.png 32
render_representation AppIcon-32@2x.png 64
render_representation AppIcon-128.png 128
render_representation AppIcon-128@2x.png 256
render_representation AppIcon-256.png 256
render_representation AppIcon-256@2x.png 512
render_representation AppIcon-512.png 512
render_representation AppIcon-512@2x.png 1024

jq empty "$catalog_manifest"

for optimized_file in "$working_directory"/AppIcon-*.png; do
    cp "$optimized_file" "$catalog_directory/$(basename "$optimized_file")"
done

printf 'Generated AppIcon representations with:\n'
printf '  %s\n' "$(rsvg-convert --version | head -1)"
printf '  pngquant %s\n' "$(pngquant --version)"
printf '  %s\n' "$(oxipng --version)"

for icon_file in "$catalog_directory"/*.png; do
    shasum -a 256 "$icon_file" | awk -v size="$(stat -f %z "$icon_file")" '{ print $1, size }'
done | sort -u | awk '{ total += $2; count += 1 } END { printf "Generated %d unique PNG blobs totaling %d bytes.\n", count, total }'
